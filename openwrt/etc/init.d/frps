#!/bin/sh /etc/rc.common
# NFrp 服务端（frps）procd 启动脚本
# 安装到 /etc/init.d/frps 后执行 chmod +x && /etc/init.d/frps enable
#
# 设计要点
#   * USE_PROCD=1 交给 procd 托管 退出后由 respawn 自动拉起
#   * stdout / stderr 交给 logd 不写 flash 日志用 logread 查看
#   * 启动前等 WAN 与系统时间 路由器无 RTC 1970 年时间会破坏 TLS 与 OIDC
#   * ★ 不自动开放任何防火墙端口 见下方 fw4 说明
#
# 放行 bind_port（默认 7000）需要手动加防火墙规则 本脚本刻意不代劳
#   OpenWrt 22.03+ 用 fw4/nftables 在 /etc/config/firewall 增加
#     config rule
#         option name 'frps-bind'
#         option src 'wan'
#         option dest_port '7000'
#         option proto 'tcp'
#         option target 'ACCEPT'
#     然后 /etc/init.d/firewall reload
#   老版本 fw3 写法同理
#   ★ 面板端口（webServer）不要对外开放 需要访问请走 SSH 隧道或 VPN

# 这三个变量由 /etc/rc.common source 本脚本后读取 不是脚本自身使用
# shellcheck disable=SC2034
USE_PROCD=1
# shellcheck disable=SC2034
START=96
# shellcheck disable=SC2034
STOP=10

CONF=/etc/frp/frps.toml
BIN=/usr/bin/frps

MIN_EPOCH=1577836800

wait_for_wan() {
    local i=0
    while [ "$i" -lt 30 ]; do
        if ifstatus wan 2>/dev/null | grep -q '"up" *: *true'; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

wait_for_clock() {
    local i=0 now
    while [ "$i" -lt 30 ]; do
        now=$(date +%s 2>/dev/null || echo 0)
        case "$now" in
            ''|*[!0-9]*) now=0 ;;
        esac
        if [ "$now" -ge "$MIN_EPOCH" ]; then
            return 0
        fi
        sleep 1
        i=$((i + 1))
    done
    return 1
}

start_service() {
    [ -x "$BIN" ] || {
        logger -t frps "缺少 $BIN 跳过启动"
        return 1
    }
    [ -f "$CONF" ] || {
        logger -t frps "缺少 $CONF 跳过启动"
        return 1
    }

    if ! wait_for_wan; then
        logger -t frps "WAN 未就绪 推迟启动 网络恢复后会由接口触发器重试"
        return 1
    fi
    if ! wait_for_clock; then
        logger -t frps "系统时间未就绪 推迟启动 避免 TLS 校时失败 时间同步后会由接口触发器重试"
        return 1
    fi

    procd_open_instance
    procd_set_param command "$BIN" -c "$CONF"
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param term_timeout 10
    procd_close_instance
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_interface_trigger "interface.*" wan /etc/init.d/frps restart
}
